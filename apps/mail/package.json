{
  "main": "dist/index.js",
  "packages": {},
  "name": "neutron-mail",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build.ts && npm run mogen",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "mopack": "bun ../../packages/neutron-scripts/src/mopack.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "package:metadata": "bun ../../packages/neutron-scripts/src/package_metadata.ts",
    "validate": "bun ../../packages/neutron-scripts/src/validate.ts",
    "package": "npm run validate && npm run build && npm run mopack && npm run schema && npm run package:metadata && bun ../../packages/neutron-scripts/src/pack.ts",
    "test": "npm run typecheck && npm run package && bun test test && npm run test:motoko && npm run test:memory",
    "test:memory": "bun ../../packages/neutron-scripts/src/run_motoko_program.ts test/memory_release.test.mo",
    "test:motoko": "bun test/motoko/run.ts",
    "typecheck": "tsc -b --pretty false",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json --pretty false",
    "test:e2e:list": "playwright test -c playwright.config.ts --list",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:vetkeys:kat": "bun test test/vetkeys_real_kat.test.ts",
    "vetkeys:kat:prepare": "bun scripts/prepare-vetkeys-kat.ts",
    "vetkeys:kat:capture": "bun scripts/capture-vetkeys-kat.ts",
    "watch": "bun build.ts watch"
  },
  "license": "LicenseRef-Neutron-Sovereign-Application-License-1.0",
  "description": "Private encrypted messages between Neutron canisters",
  "dependencies": {
    "@dfinity/principal": "^3.4.3",
    "@dfinity/vetkeys": "0.4.0",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "2.2.0",
    "neutron-design-system": "^1.1.0",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/identity": "^3.4.3",
    "@noble/curves": "1.9.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "neutron-provision": "^0.1.0",
    "neutron-scripts": "^1.1.0"
  }
}
