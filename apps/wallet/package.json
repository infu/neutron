  "description": "Canister-owned ICRC token balances",
  "dependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "neutron-design-system": "^1.1.0",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "neutron-scripts": "^1.1.0"
  }
}
