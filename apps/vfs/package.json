{
  "main": "dist/index.js",
  "packages": {},
  "name": "neutron-vfs",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build.ts && npm run mogen",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "mopack": "bun ../../packages/neutron-scripts/src/mopack.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "unicode:check": "bun scripts/generate_unicode_nfc.ts --check",
    "validate": "npm run unicode:check && bun ../../packages/neutron-scripts/src/validate.ts",
    "release:clean": "bun scripts/release.ts clean",
    "release:browser": "bun scripts/worker_browser_release.ts",
    "release:evidence": "bun scripts/release.ts evidence",
    "release:verify": "bun scripts/release.ts verify",
    "release:reset-memory-lock": "bun scripts/release.ts reset-memory-lock",
    "package": "npm run release:clean && npm run validate && npm run build && npm run typecheck:clean && npm run mopack && npm run schema && npm run release:evidence && bun ../../packages/neutron-scripts/src/pack.ts && npm run release:verify",
    "package:fresh": "NEUTRON_FILES_V2_FRESH_REINSTALL=1 npm run release:reset-memory-lock && npm run package",
    "watch": "bun build.ts watch",
    "test": "npm run package && npm run test:ts && npm run test:motoko",
    "test:ts": "bun scripts/test.ts",
    "test:browser-release": "bun test test/worker_browser_release.test.ts",
    "test:release": "bun test test/release_contract.test.ts test/privacy_release_v2.test.ts",
    "test:motoko": "bun test/motoko/run.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:clean": "tsc -b --pretty false --force"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "description": "Shared links, protected files, and everyday workspace storage for Neutron",
  "dependencies": {
    "@dfinity/candid": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "@dfinity/vetkeys": "0.4.0",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "2.2.0",
    "neutron-design-system": "^1.1.0",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "icblast": "^4.3.0",
    "neutron-motoko-wasm": "^1.1.0",
    "neutron-scripts": "^1.1.0"
  }
}
