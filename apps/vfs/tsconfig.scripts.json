{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.bun.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "build.ts",
    "scripts/**/*.ts",
    "src/crypto/**/*.ts",
    "src/protocol/**/*.ts",
    "src/resident/**/*.ts",
    "src/vault/**/*.ts",
    "src/vfs_store.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
