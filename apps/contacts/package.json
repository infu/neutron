{
  "main": "dist/index.js",
  "packages": {},
  "name": "neutron-contacts",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "bun build.ts && npm run mogen",
    "mogen": "bun ../../packages/neutron-scripts/src/mogen.ts",
    "mopack": "bun ../../packages/neutron-scripts/src/mopack.ts",
    "schema": "bun ../../packages/neutron-scripts/src/method_schema.ts",
    "package:metadata": "bun ../../packages/neutron-scripts/src/package_metadata.ts",
    "validate": "bun ../../packages/neutron-scripts/src/validate.ts",
    "package": "npm run validate && npm run build && npm run mopack && npm run schema && npm run package:metadata && bun ../../packages/neutron-scripts/src/pack.ts",
    "watch": "bun build.ts watch",
    "test:memory": "bun ../../packages/neutron-scripts/src/run_motoko_program.ts test/memory_release.test.mo",
    "test:motoko": "bun test/motoko/run.ts && bun test/motoko/run.ts neutron_integrity_test.mo && bun test/motoko/run.ts backend_compile_test.mo",
    "test": "npm run package && bun test && npm run test:motoko && npm run test:memory"
  },
  "author": "",
  "license": "LicenseRef-Neutron-Sovereign-Application-License-1.0",
  "description": "Private multi-network contacts for Neutron apps and agents",
  "dependencies": {
    "@dfinity/principal": "^3.4.3",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "neutron-design-system": "^1.1.0",
    "neutron-tools": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-sass-plugin": "^3.7.0",
    "neutron-scripts": "^1.1.0"
  }
}
