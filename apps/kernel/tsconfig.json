{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.bun.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "build.ts",
    "evidence/**/*.ts",
    "generate_package_metadata.ts",
    "moassemble.ts",
    "stamp_wasm_metadata.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
