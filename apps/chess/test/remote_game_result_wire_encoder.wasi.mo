import Array "mo:core/Array";
import RemoteGameResultWire "../backend/RemoteGameResultWire";

// This test runs as compiled WASI because the Motoko interpreter does not
// implement `to_candid`. It locks the live Motoko encoder to the frozen V1
// parser, independently of the didc-generated byte fixtures.
let honestOk : RemoteGameResultWire.GameResult = #ok({
    tile_id = "tile";
    game_id = "game";
    mode = "remote_guest";
    computer_level = null;
    revision = 2;
    rows = ["....k...", "........", "........", "........", "........", "........", "........", "....K..."];
    turn = "white";
    castling = {
        white_kingside = true;
        white_queenside = false;
        black_kingside = false;
        black_queenside = true;
    };
    en_passant = ?"e6";
    halfmove_clock = 1;
    fullmove_number = 2;
    status = "active";
    winner = null;
    in_check = false;
    draw_offer_by = null;
    local_color = ?"white";
    remote_connected = true;
    position_keys = ["position"];
    legal_moves = [{ from = "e2"; to = "e4"; promotion = null }];
    history = [{
        ply = 1;
        from = "e2";
        to = "e4";
        piece = "wP";
        placed = "wP";
        captured = null;
        promotion = null;
        special = "normal";
        notation = "e4";
        at = -1;
    }];
});
assert (RemoteGameResultWire.decode(to_candid (honestOk)) == ?honestOk);

let honestError : RemoteGameResultWire.GameResult = #err({
    code = "conflict";
    message = "revision changed";
    expected_revision = ?1;
    actual_revision = ?2;
});
assert (RemoteGameResultWire.decode(to_candid (honestError)) == ?honestError);

func repeated(value : Text, count : Nat) : Text {
    var result = "";
    var index = 0;
    while (index < count) {
        result #= value;
        index += 1;
    };
    result;
};

// Exercise the largest honest compact protocol view: 128 recent moves, one
// maximal repetition key, and all 256 bounded legal moves. This must remain
// below both the 32 KiB response limit and the 64 KiB pushed-request limit.
let maximalView : RemoteGameResultWire.GameView = {
    tile_id = repeated("t", 128);
    game_id = repeated("g", 128);
    mode = "remote_guest";
    computer_level = null;
    revision = 10_000_000;
    rows = ["....k...", "........", "........", "........", "........", "........", "........", "....K..."];
    turn = "white";
    castling = {
        white_kingside = true;
        white_queenside = true;
        black_kingside = true;
        black_queenside = true;
    };
    en_passant = ?"e6";
    halfmove_clock = 100_000_000;
    fullmove_number = 100_000_000;
    status = "active";
    winner = ?"white";
    in_check = true;
    draw_offer_by = ?"black";
    local_color = ?"white";
    remote_connected = true;
    position_keys = [repeated("p", 128)];
    legal_moves = Array.tabulate<RemoteGameResultWire.LegalMoveView>(
        256,
        func(index) {
            {
                from = if (index % 2 == 0) "a7" else "h2";
                to = if (index % 2 == 0) "a8" else "h1";
                promotion = ?"q";
            };
        },
    );
    history = Array.tabulate<RemoteGameResultWire.MoveView>(
        128,
        func(index) {
            {
                ply = index + 1;
                from = "a7";
                to = "a8";
                piece = "wP";
                placed = "wQ";
                captured = ?"bQ";
                promotion = ?"q";
                special = "castle_queenside";
                notation = repeated("n", 64);
                at = -10_000_000_000_000_000_000_000;
            };
        },
    );
};
let maximalReply : RemoteGameResultWire.GameResult = #ok(maximalView);
let maximalReplyBytes = to_candid (maximalReply);
assert (maximalReplyBytes.size() <= 32_768);
assert (RemoteGameResultWire.decode(maximalReplyBytes) == ?maximalReply);

let maximalPush = {
    op = "push";
    game_id = maximalView.game_id;
    from = null : ?Text;
    to = null : ?Text;
    promotion = null : ?Text;
    action = null : ?Text;
    player_color = null : ?Text;
    expected_revision = ?maximalView.revision;
    state = ?maximalView;
};
let maximalIngressRequest = {
    method = "exchange";
    payload = to_candid (maximalPush);
};
assert ((to_candid (maximalIngressRequest)).size() <= 65_536);
