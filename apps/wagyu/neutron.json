          "max_response_bytes": 128,
          "max_calls_per_hour": 240,
          "max_calls_per_caller_per_hour": 24,
          "required_cycles": 50000000
        },
        {
          "protocol": "wagyu_v1",
          "id": "deliver",
          "handler": "wagyu_ingress_deliver_v1",
          "mode": "update",
          "caller": "canister",
          "max_request_bytes": 16384,
          "max_response_bytes": 512,
          "max_calls_per_hour": 1800,
          "max_calls_per_caller_per_hour": 240,
          "required_cycles": 200000000
        },
        {
          "protocol": "wagyu_v1",
          "id": "like",
          "handler": "wagyu_ingress_like_v1",
          "mode": "update",
          "caller": "canister",
