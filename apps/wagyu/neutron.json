{
  "format": 3,
  "id": "wagyu",
  "name": "Wagyu",
  "version": 302,
  "update_source": "233tv-xiaaa-aaaay-aacta-cai",
  "description": "Certified peer-to-peer social protocol for Neutron nodes",
  "src": "main.mo",
  "backend": {
    "capabilities": {
      "backend_calls": {
        "api": 1
      },
      "deferred_timers": {
        "api": 1
      },
      "certified_assets": {
        "api": 2
      }
    }
  },
  "background": {
    "path": "service.html",
