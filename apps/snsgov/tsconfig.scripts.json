{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.bun.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "build.ts",
    "scripts/**/*.ts",
    "src/data/**/*.ts",
    "src/tools/**/*.ts",
    "src/service.ts",
    "src/candid/**/*.d.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
