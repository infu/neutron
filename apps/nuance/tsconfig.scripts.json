{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.bun.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "build.ts",
    "src/api.ts",
    "src/format.ts",
    "src/html.tsx",
    "src/markup.ts",
    "src/nuance/**/*.ts",
    "src/tools.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
