    },
    "backend_calls": {
      "api": 1,
      "description": "Read EVM networks and submit signed transactions through the EVM RPC canister",
      "reservation_scopes": [
        "exact"
      ],
      "install_reservations": [
        {
          "kind": "exact",
          "principal": "7hfb6-caaaa-aaaar-qadga-cai",
          "method": "request"
        },
        {
          "kind": "exact",
          "principal": "7hfb6-caaaa-aaaar-qadga-cai",
          "method": "requestCost"
        },
        {
          "kind": "exact",
          "principal": "7hfb6-caaaa-aaaar-qadga-cai",
          "method": "eth_sendRawTransaction"
        },
        {
          "kind": "exact",
          "principal": "7hfb6-caaaa-aaaar-qadga-cai",
          "method": "eth_sendRawTransactionCyclesCost"
        }
      ],
      "max_concurrency": 20,
      "max_cycles_per_call": 100000000000000,
      "max_cycles_per_day": 1000000000000000
    }
  },
  "tiles": [
