import Blob "mo:core/Blob";
import Hex "../backend/evm/Hex";
import Keccak "../backend/evm/Keccak";
import Personal "../backend/evm/Personal";
import Rlp "../backend/evm/Rlp";
import Transaction "../backend/evm/Transaction";
import Debug "mo:core/Debug";
import Runtime "mo:core/Runtime";
func bytes(s : Text) : Blob { switch (Hex.decode(s)) { case (#ok(b)) b; case (#err(e)) Runtime.trap(e) } };
func ok<T>(r : {#ok:T;#err:Text}) : T { switch(r) {case (#ok(v)) v; case (#err(e)) Runtime.trap(e)} };
func fails<T>(r : {#ok:T;#err:Text}) : Bool {switch(r) {case (#err(_)) true; case _ false}};
// Expected bytes generated independently using viem 2.55.1 / noble, plus published EIP-155 vector.
assert Hex.encode(Keccak.hash(bytes("0x"))) == "0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470";
assert Hex.encode(Personal.hash(bytes("0x"))) == "0x5f35dce98ba4fba25530a026ed80b2cecdaa31091ba4958b99b52ea1d068adad";
assert Hex.encode(Rlp.encode(#bytes(bytes("0x")))) == "0x80";
