assert Hex.encode(Personal.hash(bytes("0x0d"))) == "0xe77f0c4edfab6a8fc52d8ded09e0443726cb31422ad19cedecd6e0fce901e77d";
assert Hex.encode(Rlp.encode(#bytes(bytes("0x0d")))) == "0x0d";
