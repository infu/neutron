assert Hex.encode(Rlp.encode(#bytes(bytes("0xa0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b")))) == "0xa0a0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b";
