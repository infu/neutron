assert Hex.encode(Rlp.encode(#bytes(bytes("0xd89d6227ecb1763b00c58a4f14d99e6328edb2773c01c68b5015da9f6429eeb3783d02c78c5116dba0652aefb4793e03c88d5217dca1662b")))) == "0xb838d89d6227ecb1763b00c58a4f14d99e6328edb2773c01c68b5015da9f6429eeb3783d02c78c5116dba0652aefb4793e03c88d5217dca1662b";
assert Hex.encode(Keccak.hash(bytes("0xdba0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b4005ca8f5419dea3682df2b77c4106cb90551adfa4692ef3b87d4207cc91561be0a56a2ff4b97e4308cd92571ce1a66b30f5ba7f4409ce93581de2a76c31f6bb80450acf94591ee3a86d32f7bc81460bd0955a1fe4a96e33f8bd82470cd1965b20e5aa6f34f9"))) == "0xb910e27ea277c09b03ee3c666e12939b8118c46cc59bd1eeec92141c2664aae3";
assert Hex.encode(Personal.hash(bytes("0xdba0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b4005ca8f5419dea3682df2b77c4106cb90551adfa4692ef3b87d4207cc91561be0a56a2ff4b97e4308cd92571ce1a66b30f5ba7f4409ce93581de2a76c31f6bb80450acf94591ee3a86d32f7bc81460bd0955a1fe4a96e33f8bd82470cd1965b20e5aa6f34f9"))) == "0x7e6cd4f3ad4d0df43f0256fd5498a592ba3a2f60c67c91fa52594ee1f3d15b6c";
assert Hex.encode(Keccak.hash(bytes("0xe8ad7237fcc1864b10d59a5f24e9ae7338fdc2874c11d69b6025eaaf7439fec3884d12d79c6126ebb0753affc4894e13d89d6227ecb1763b00c58a4f14d99e6328edb2773c01c68b5015da9f6429eeb3783d02c78c5116dba0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b4005ca8f5419dea3682df2b77c4106cb"))) == "0x85b30c3f448d94bf6a6b0eea0a0e15e26e7f6dc9e4d668ef15d2e5534b796bea";
assert Hex.encode(Personal.hash(bytes("0xe8ad7237fcc1864b10d59a5f24e9ae7338fdc2874c11d69b6025eaaf7439fec3884d12d79c6126ebb0753affc4894e13d89d6227ecb1763b00c58a4f14d99e6328edb2773c01c68b5015da9f6429eeb3783d02c78c5116dba0652aefb4793e03c88d5217dca1662bf0b57a3f04c98e5318dda2672cf1b67b4005ca8f5419dea3682df2b77c4106cb"))) == "0xb8664a0edfe6a4136bb7ae12a5d1c9bc92ab89fdcb57246f50f72e5babc7f43f";
assert Hex.encode(Keccak.hash(bytes("0xf5ba7f4409ce93581de2a76c31f6bb80450acf94591ee3a86d32f7bc81460bd0955a1fe4a96e33f8bd82470cd1965b20e5aa6f34f9be83480dd2975c21e6ab7035fabf84490ed3985d22e7ac7136fbc0854a0fd4995e23e8ad7237fcc1864b10d59a5f24e9ae7338fdc2874c11d69b6025eaaf7439fec3884d12d79c6126ebb0753affc4894e13d89d"))) == "0x528fd5fdf2db3068bd5a76b0a9978120a52881bee5f96334d7bd8a2f760a0ee5";
assert Hex.encode(Personal.hash(bytes("0xf5ba7f4409ce93581de2a76c31f6bb80450acf94591ee3a86d32f7bc81460bd0955a1fe4a96e33f8bd82470cd1965b20e5aa6f34f9be83480dd2975c21e6ab7035fabf84490ed3985d22e7ac7136fbc0854a0fd4995e23e8ad7237fcc1864b10d59a5f24e9ae7338fdc2874c11d69b6025eaaf7439fec3884d12d79c6126ebb0753affc4894e13d89d"))) == "0x0fab3c1c5793e66dd72b148e5cf684ceb5558755fd0cea3619eb7d18762dd4ef";
