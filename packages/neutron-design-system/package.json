{
  "name": "neutron-design-system",
  "version": "1.1.0",
  "description": "Scoped dark UI design system for Neutron app frontends.",
  "type": "module",
  "main": "dist/classes.js",
  "types": "dist/classes.d.ts",
  "exports": {
    ".": {
      "types": "./dist/classes.d.ts",
      "import": "./dist/classes.js",
      "default": "./dist/classes.js"
    },
    "./styles.scss": "./styles.scss",
    "./tokens.scss": "./tokens.scss",
    "./base.scss": "./base.scss",
    "./layout.scss": "./layout.scss",
    "./components.scss": "./components.scss",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "*.scss",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "test": "npm run build && bun test",
    "prepack": "npm run build",
    "publish:check": "npm run test && npm pack --dry-run"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "sass": "^1.101.0"
  }
}
