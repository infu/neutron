type CanisterSettings = record {
  controllers : opt vec principal;
  compute_allocation : opt nat;
  memory_allocation : opt nat;
  freezing_threshold : opt nat;
  reserved_cycles_limit : opt nat;
  log_visibility : opt variant {
    controllers;
    public;
    allowed_viewers : vec principal;
  };
  wasm_memory_limit : opt nat;
  wasm_memory_threshold : opt nat;
  environment_variables : opt vec record { name : text; value : text };
  snapshot_visibility : opt variant {
    controllers;
    public;
    allowed_viewers : vec principal;
  };
  minimum_incoming_canister_call_cycles : opt nat;
};
type SubnetSelection = variant {
  Subnet : record { subnet : principal };
  Filter : record { subnet_type : opt text };
};
type NotifyError = variant {
  Refunded : record { reason : text; block_index : opt nat64 };
  Processing;
  TransactionTooOld : nat64;
  InvalidTransaction : text;
  Other : record { error_code : nat64; error_message : text };
};
service : {
  notify_create_canister : (record {
    block_index : nat64;
    controller : principal;
    subnet_type : opt text;
    subnet_selection : opt SubnetSelection;
    settings : opt CanisterSettings;
  }) -> (variant { Ok : principal; Err : NotifyError });
  get_default_subnets : () -> (vec principal) query;
  get_subnet_types_to_subnets : () ->
    (record { data : vec record { text; vec principal } }) query;
  get_principals_authorized_to_create_canisters_to_subnets : () ->
    (record { data : vec record { principal; vec principal } }) query;
  get_icp_xdr_conversion_rate : () -> (record {
    data : record {
      timestamp_seconds : nat64;
      xdr_permyriad_per_icp : nat64;
    };
    hash_tree : blob;
    certificate : blob;
  }) query;
};
